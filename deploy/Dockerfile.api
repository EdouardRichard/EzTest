# syntax=docker/dockerfile:1
#
# Multi-stage build for the EzTest Go API. The runtime image is Alpine, runs as
# a non-root user and ships docs/openapi/api.yaml at the working-directory path
# the default EZTEST_OPENAPI_PATH expects. Docker is not available on the
# development host; this file is delivered but not built there.

FROM golang:1.24.6-alpine AS build

WORKDIR /src

# Dependencies first so the module cache layer survives source-only changes.
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

ARG VERSION=dev
ARG COMMIT=

RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X github.com/EdouardRichard/EzTest/backend/internal/server.Version=${VERSION} -X github.com/EdouardRichard/EzTest/backend/internal/server.Commit=${COMMIT}" \
    -o /out/eztest ./cmd/eztest

FROM alpine:3.21

# ca-certificates is required for HTTPS LLM gateways; wget backs the health
# check; tzdata makes timestamps predictable in logs.
RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -S -g 10001 eztest \
    && adduser -S -u 10001 -G eztest -h /app eztest

WORKDIR /app

COPY --from=build --chown=eztest:eztest /out/eztest ./eztest
COPY --chown=eztest:eztest docs/openapi/api.yaml ./docs/openapi/api.yaml

# P7 multi-replica shape: every content path is a DB setting under
# paths.data_root (default ./.data). The shared data volume is mounted at /data
# and ./.data is a symlink to it, so both API replicas see the same files with
# the default settings. The runtime user owns /data; Docker seeds a fresh named
# volume with that ownership.
RUN mkdir -p /data \
    && chown eztest:eztest /data \
    && ln -s /data /app/.data

USER eztest

ENV EZTEST_API_PORT=13333

EXPOSE 13333

ENTRYPOINT ["./eztest"]
