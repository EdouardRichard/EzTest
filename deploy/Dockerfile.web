# syntax=docker/dockerfile:1
#
# Multi-stage build for the Next.js frontend using the standalone output.
# `output: "standalone"` is set in frontend/next.config.ts. Docker is not
# available on the development host; this file is delivered but not built
# there. Build from the repository root (context `..` in docker-compose.yml).

FROM node:22-alpine AS base

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

# Pin the package manager to the version that produced pnpm-lock.yaml.
RUN corepack enable && corepack prepare pnpm@11.28.5 --activate

WORKDIR /app

FROM base AS deps

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS build

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:13333
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_TELEMETRY_DISABLED=1

RUN pnpm build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=6868 \
    HOSTNAME=0.0.0.0

RUN addgroup -S -g 1001 nodejs \
    && adduser -S -u 1001 -G nodejs nextjs

COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

# The repository has no public/ directory at P0. If one is added, copy it here:
# COPY --from=build --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 6868

CMD ["node", "server.js"]
