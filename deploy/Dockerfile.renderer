# EzTest PDF renderer (Playwright).
#
# The official Playwright image already ships the pinned Chromium revision, so
# the renderer needs no browser download. Only the renderer sources are copied:
# the API sources, frontend and executor never enter this image.
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.renderer -t eztest-renderer .
FROM mcr.microsoft.com/playwright:v1.64.1-noble

ENV NODE_ENV=production \
    EZTEST_RENDERER_ADDR=0.0.0.0:13337 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Renderer dependencies only (playwright). No lockfile requirement keeps this
# image buildable while the standalone renderer package evolves.
COPY renderer/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund \
    && rm -rf /root/.npm

COPY renderer/src ./src

RUN chown -R pwuser:pwuser /app

EXPOSE 13337

USER pwuser

HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=20s \
    CMD ["node", "-e", "fetch('http://127.0.0.1:13337/healthz').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "src/server.mjs"]
