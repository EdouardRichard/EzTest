# EzTest environment template.
#
# Copy this file to `.env` at the repository root and replace every
# `<placeholder>`. `.env` is gitignored: never commit real credentials, keys or
# tokens. The local development host also keeps its generated password in the
# gitignored docs/dev-setup.local.md.
#
# Generate EZTEST_SECRET_KEYS (a 32-byte AES-256 key per version) with:
#
#   $bytes = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   '{"1":"' + [Convert]::ToBase64String($bytes) + '"}'
#
# The value must be a JSON object mapping key version to base64 32-byte key.
# Rotate by adding a new version and bumping EZTEST_SECRET_KEY_ACTIVE; old
# versions must stay present while stored values are re-encrypted.

# ---- API process ----
EZTEST_ENV=dev
EZTEST_HTTP_ADDR=:13333
EZTEST_WEB_ORIGIN=http://localhost:6868
EZTEST_DATABASE_URL=postgres://eztest:<db-password>@localhost:5433/eztest?sslmode=disable
EZTEST_TEST_DATABASE_URL=postgres://eztest:<db-password>@localhost:5433/eztest_test?sslmode=disable
EZTEST_ADMIN_USERNAME=admin
EZTEST_ADMIN_PASSWORD=<admin-password-at-least-10-characters>
EZTEST_SECRET_KEYS={"1":"<base64-encoded-32-byte-key>"}
EZTEST_SECRET_KEY_ACTIVE=1
EZTEST_STORAGE_DIR=.data/objects
EZTEST_ENABLE_TEST_ENDPOINTS=true
EZTEST_LOG_LEVEL=info
# Path to the hand-maintained OpenAPI document, relative to the process working
# directory unless absolute. Docker sets this to docs/openapi/api.yaml.
EZTEST_OPENAPI_PATH=docs/openapi/api.yaml

# ---- P1 Agent runtime ----
# Read-only root for file.list/file.read; empty disables the file tools.
EZTEST_AGENT_FILE_ROOT=
# Comma-separated hosts allowed for http.get (default 127.0.0.1,localhost).
EZTEST_AGENT_HTTP_ALLOWLIST=127.0.0.1,localhost
# Per-tool timeout, 1000-60000 ms (default 10000).
EZTEST_AGENT_TOOL_TIMEOUT_MS=10000
# Process-wide concurrent run limit, 1-32 (default 4).
EZTEST_AGENT_MAX_CONCURRENT_RUNS=4

# ---- P3 version context (D29/D30) ----
# Root of the version attachment filesystem store (default
# .data/version-attachments). Docker maps this to /data/version-attachments.
EZTEST_VERSION_ATTACHMENT_DIR=.data/version-attachments
# Snowflake node ID for application-generated primary keys, 0-1023 (default 1).
# Every concurrently running API instance must use a distinct node ID.
EZTEST_SNOWFLAKE_NODE_ID=1

# ---- P4 code intelligence (D32/D33) ----
# Max changed files sent to the LLM per analysis, 1-200 (default 20); extra
# files are skipped and counted in stats.
EZTEST_CODEINTEL_MAX_CHANGED_FILES=20
# Max bytes of one file used for AI analysis/reads, 1024-1048576
# (default 65536); larger files are treated as unsupported.
EZTEST_CODEINTEL_MAX_FILE_BYTES=65536
# Max file entities stored by one T0 index run, 1-50000 (default 5000);
# exceeding it sets truncated=true.
EZTEST_CODEINTEL_MAX_INDEX_FILES=5000
# Total timeout of one analysis run in ms, 30000-600000 (default 180000),
# including every LLM call.
EZTEST_CODEINTEL_ANALYSIS_TIMEOUT_MS=180000
# In-process analysis worker concurrency for a single instance, 1-4 (default 1).
EZTEST_CODEINTEL_MAX_CONCURRENT_ANALYSES=1
# Prompt version, 1-32 chars matching [a-z0-9.-] (default p4.1); it is part
# of the cache key and fact versions, so changing it invalidates old caches.
EZTEST_CODEINTEL_PROMPT_VERSION=p4.1
# Max excerpt lines per evidence item, 1-200 (default 40).
EZTEST_CODEINTEL_MAX_EXCERPT_LINES=40
# Max unified diff bytes returned for one file, 4096-1048576
# (default 262144); exceeding it sets truncated=true.
EZTEST_CODEINTEL_MAX_DIFF_BYTES=262144

# ---- P5 case mindmap and design review (D30/D35/D36) ----
# Root of the export filesystem store (default .data/exports). PostgreSQL stores
# only the root-relative path, sha256 and size; export files are written 0600
# under a 0700 root and are never stored in the database. Docker maps this to
# /data/exports.
EZTEST_EXPORT_DIR=.data/exports
# Max cases accepted from one design run/materialization, 1-60 (default 60).
EZTEST_MINDMAP_MAX_CASES=60
# Max HTTP requests issued by one exploration run, 1-40 (default 40); extra
# links are dropped and stats.truncated is set.
EZTEST_EXPLORE_MAX_REQUESTS=40
# Per-request exploration timeout in ms, 500-30000 (default 5000); the total
# run also has a 60s cap and a 512 KiB response parsing cap.
EZTEST_EXPLORE_TIMEOUT_MS=5000

# ---- P6 executor (deploy/docker-compose.yml) ----
# URL the API uses to reach the Playwright executor. Compose points the api
# service at http://executor:13336; local dev uses the loopback default.
EZTEST_EXECUTOR_URL=http://127.0.0.1:13336
# Bearer token shared by the API and the executor. Compose refuses to start
# without it, so set the same value here and in the api environment.
EZTEST_EXECUTOR_TOKEN=<executor-token>
# Executor listen address; Compose overrides it to 0.0.0.0:13336.
EZTEST_EXECUTOR_ADDR=127.0.0.1:13336
# Concurrent browser contexts (default 8).
EZTEST_EXECUTOR_MAX_CONTEXTS=8
# Optional explicit Chromium binary for local dev. Leave empty to use the
# pinned Playwright revision, a cached revision, or system Chrome/Edge.
EZTEST_EXECUTOR_CHROMIUM_PATH=
# Optional self-test switch: 1 allows data:text/html pages. Keep empty in
# production; the allow list and scheme checks then reject data: URLs.
EZTEST_EXECUTOR_ALLOW_DATA_PAGES=

# ---- P6 execution (backend/internal/config/config.go) ----
# Root directory of the immutable execution evidence store. Paths under it are
# generated by the API ({batch_id}/{case_run_id}/{evidence_id}.{ext}); clients
# never see them. The acceptance gate uses .tmp/p6-evidence.
EZTEST_EVIDENCE_DIR=.data/evidence
# Concurrent case runs per process, 1-8 (default 3).
EZTEST_EXEC_MAX_CONCURRENT_CASES=3
# Agent tool-call budget per case, 1-1000 (default 80); exhaustion ends the
# case inconclusive(model), never failed.
EZTEST_EXEC_MAX_TOOL_CALLS=80
# Per-case wall-clock timeout in ms, 1000-3600000 (default 900000 = 15 min).
EZTEST_EXEC_CASE_TIMEOUT_MS=900000
# Cases accepted in one batch, 1-1000 (default 200); a larger selection is a
# 422 too_many_cases.
EZTEST_EXEC_MAX_CASES_PER_BATCH=200
# Scheduler/recovery tick interval in ms, 100-60000 (default 2000). Lower it
# (e.g. 200) for responsive pause/resume acceptance runs.
EZTEST_EXEC_WORKER_INTERVAL_MS=2000
# Largest single evidence artifact in bytes, 1024-104857600 (default 10 MiB).
EZTEST_EXEC_EVIDENCE_MAX_BYTES=10485760
# Evidence artifacts per case, 1-1000 (default 100); over-limit writes fail
# rather than silently truncating.
EZTEST_EXEC_EVIDENCE_PER_CASE=100

# ---- P7 delivery (backend/internal/config/config.go, D30/D43-D52) ----
# Root of the P7 report Markdown store. PostgreSQL keeps only the root-relative
# path, sha256 and size; directories are 0700 and files 0600. The API creates it
# at startup. Docker maps this to /data/reports when the volume is added.
EZTEST_REPORT_DIR=.data/reports
# Per-tick autonomous batch budget (terminal batches and continuing versions),
# read directly by the execution autonomy worker; unset/invalid falls back to 4.
# The design range is 1-20; the current worker does not clamp larger values.
EZTEST_AUTONOMY_BATCHES_PER_TICK=4
# P7 spec §16.1 target variables (1-100 / 1-20). The current build enforces the
# same per-run caps (20 failure cases / 5 supplement cases) in code and does not
# read these variables yet; wiring is deferred.
EZTEST_ANALYSIS_MAX_CASES=20
EZTEST_SUPPLEMENT_MAX_CASES=5
# Largest db_result payload of one db assertion in bytes, 64 KiB-16 MiB
# (default 1048576). Over-limit results fail with db_result_truncated.
EZTEST_DB_RESULT_MAX_BYTES=1048576
# SQL text limit of one db assertion in bytes, 1 KiB-64 KiB (default 16384).
EZTEST_DB_SQL_MAX_BYTES=16384

# ---- P8 hardening (rate limiting + evidence GC) ----

# Per-user (authenticated) / per-IP (public) token bucket: requests per second,
# 0-1000 (default 50). 0 disables the ordinary token bucket; the SSE concurrency
# cap below stays active.
EZTEST_RATE_LIMIT_RPS=50
# Burst capacity of the token bucket, 1-5000 (default 100).
EZTEST_RATE_LIMIT_BURST=100
# Concurrent SSE streams per user/IP, 1-100 (default 10); over the cap answers
# 429 rate_limited with Retry-After.
EZTEST_RATE_LIMIT_SSE_MAX=10
# Allow a non-dry-run evidence GC. Default false keeps POST /api/admin/gc
# dry-run only; production must opt in explicitly.
EZTEST_GC_ENABLED=false
# Evidence retention in days, 1-3650 (default 30). Unreferenced evidence older
# than this is a GC candidate after the reference protections are applied.
EZTEST_GC_RETENTION_DAYS=30
# Number of latest batches whose evidence is always protected, 1-50 (default 3).
EZTEST_GC_BATCH_KEEP=3
# Multi-instance leader lock (design spec §10.5). Every API instance must use a
# distinct id; it appears in the startup/exit and lock logs. Default is
# hostname-pid, at most 64 characters. Uncomment to pin a stable name.
# EZTEST_INSTANCE_ID=api-1
# PostgreSQL advisory lock key shared by every API instance (int64, default
# 1163411512). The scheduler, autonomy worker and daily maintenance derive
# adjacent keys from it, so all instances must use the same value.
EZTEST_LEADER_LOCK_KEY=1163411512
# The daily evidence maintenance pass (leader-only) is a dry-run unless
# EZTEST_GC_ENABLED=true above explicitly enables the purge.

# ---- Optional first-boot LLM seed (lowercase names are intentional) ----
# Leave llm_key empty to skip real upstream calls. The configuration can also
# be created in the admin UI after login.
llm_base_url=
llm_key=
llm_model_name=

# ---- Docker Compose only (deploy/docker-compose.yml) ----
# The Compose file interpolates these into the postgres service and the API
# database URL; POSTGRES_PASSWORD is required there. Use the same password as
# EZTEST_DATABASE_URL above when deploying.
POSTGRES_USER=eztest
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=eztest
# Inlined into the browser bundle at image build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:13333
