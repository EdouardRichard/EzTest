# EzTest 0.2 — the ONLY four startup variables.
# Copy to `.env` (gitignored). Everything else lives in the DB settings center.
#
# EZTEST_DATABASE_URL  PostgreSQL URL (required)
# EZTEST_API_PORT      API listen port (default 13333)
# EZTEST_WEB_PORT      Web port; CORS origin is derived from it (default 6868)
# EZTEST_EXECUTOR_PORT Executor port; default executor URL is derived (default 13336)
#
# Do not add a fifth EZTEST_* variable for runtime configuration.
EZTEST_DATABASE_URL=postgres://eztest:<db-password>@localhost:5433/eztest_v02?sslmode=disable
EZTEST_API_PORT=13333
EZTEST_WEB_PORT=6868
EZTEST_EXECUTOR_PORT=13336
