{
  "name": "eztest-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EzTest execution service (executor protocol v2, general workstation)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 --test-force-exit \"test/*.test.mjs\""
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.15.0"
  }
}
