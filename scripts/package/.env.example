# EzTest packaged runtime configuration template.
#
# This file is the template that `init-config.ps1` / `init-config.sh` copy to
# `.env`. Those scripts replace the `__PACKAGE_ROOT__` tokens with the absolute
# path of this package, generate the secret values below and (when passed with
# `-DatabaseUrl` / `--database-url` or `EZTEST_DATABASE_URL`) fill in the
# PostgreSQL connection string. `.env` is local and secret: never commit it,
# never paste it into an issue.
#
# Only PostgreSQL 17 is an external prerequisite. See PACKAGE.md.
#
# Re-run `init-config` with -Force / --force to regenerate the secrets (the old
# `.env` is kept as `.env.bak`). Regenerating EZTEST_SECRET_KEYS makes LLM
# credentials already stored in PostgreSQL undecryptable.

# ---- API process ----
EZTEST_ENV=production
# Bind address of the Go API. Package default 127.0.0.1:13333.
EZTEST_HTTP_ADDR=127.0.0.1:13333
# Browser origin allowed by CORS; must match the URL used to open the web UI.
EZTEST_WEB_ORIGIN=http://localhost:6868
# REQUIRED: PostgreSQL 17 connection string. Generated by init-config when
# -DatabaseUrl/--database-url (or EZTEST_DATABASE_URL) is provided; replace this
# placeholder by hand otherwise.
EZTEST_DATABASE_URL=postgres://eztest:<db-password>@localhost:5433/eztest?sslmode=disable
EZTEST_ADMIN_USERNAME=admin
# Generated by init-config. Seeded once on the first API start; keep it.
EZTEST_ADMIN_PASSWORD=<admin-password-at-least-10-characters>
# Generated by init-config: AES-256 keyring, 32 random bytes base64 per version.
EZTEST_SECRET_KEYS={"1":"<base64-encoded-32-byte-key>"}
EZTEST_SECRET_KEY_ACTIVE=1
EZTEST_LOG_LEVEL=info
EZTEST_ENABLE_TEST_ENDPOINTS=false
# Read-only root for the P1 Agent file tools. Empty disables them (default).
EZTEST_AGENT_FILE_ROOT=

# ---- Package storage (absolute paths, rewritten by init-config) ----
EZTEST_OPENAPI_PATH=__PACKAGE_ROOT__/docs/openapi/api.yaml
EZTEST_STORAGE_DIR=__PACKAGE_ROOT__/data/objects
EZTEST_VERSION_ATTACHMENT_DIR=__PACKAGE_ROOT__/data/version-attachments
EZTEST_EVIDENCE_DIR=__PACKAGE_ROOT__/data/evidence
EZTEST_REPORT_DIR=__PACKAGE_ROOT__/data/reports
EZTEST_EXPORT_DIR=__PACKAGE_ROOT__/data/exports

# ---- Create a randomized 32-byte value for EZTEST_SECRET_KEYS on any host:
#   Linux:        head -c 32 /dev/urandom | base64 -w0
#   PowerShell:   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))

# ---- Playwright executor ----
# URL the API uses to reach the executor.
EZTEST_EXECUTOR_URL=http://127.0.0.1:13336
# Generated by init-config; the API and the executor must share it.
EZTEST_EXECUTOR_TOKEN=<executor-token>
# Executor listen address (loopback by default; the API is its only client).
EZTEST_EXECUTOR_ADDR=127.0.0.1:13336
# Concurrent browser contexts (8 needs roughly 8 GB of free RAM when busy).
EZTEST_EXECUTOR_MAX_CONTEXTS=8
# Executor-wide WebSocket allow list (comma separated). Add remote test-target
# hosts explicitly when a case needs ws/wss to a non-loopback host.
EZTEST_EXEC_ALLOWED_HOSTS=localhost,127.0.0.1
# Request cap for approved visual baselines, used by the API and the executor.
EZTEST_VISUAL_BASELINE_MAX_BYTES=5242880
# Optional explicit Chromium binary; empty uses the bundled browsers.
EZTEST_EXECUTOR_CHROMIUM_PATH=
# Optional self-test switch (data: pages). Keep empty.
EZTEST_EXECUTOR_ALLOW_DATA_PAGES=

# ---- Misc ----
EZTEST_SNOWFLAKE_NODE_ID=1
# Evidence GC stays dry-run unless this is true.
EZTEST_GC_ENABLED=false

# ---- Web process (used by start-eztest.*; NODE_ENV is fixed for production) ----
NODE_ENV=production
PORT=6868
HOSTNAME=127.0.0.1
# Bundled Playwright browser location, read by the executor.
PLAYWRIGHT_BROWSERS_PATH=__PACKAGE_ROOT__/playwright-browsers
