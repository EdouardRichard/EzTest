# EzTest 0.2 packaged runtime configuration template.
#
# `init-config.ps1` / `init-config.sh` copy this file to `.env`, replace the
# `__PACKAGE_ROOT__` tokens with the absolute path of this package and fill in
# the PostgreSQL 17 connection string (from -DatabaseUrl/--database-url,
# EZTEST_DATABASE_URL or the template placeholder). `.env` is local and secret:
# never commit it, never paste it into an issue.
#
# How EzTest 0.2 reads configuration (important):
#   * The Go API reads ONLY these four startup variables:
#       EZTEST_DATABASE_URL, EZTEST_API_PORT, EZTEST_WEB_PORT, EZTEST_EXECUTOR_PORT
#     Everything else (storage/content paths, retention, LLM provider, agent
#     budgets, executor/renderer URLs and tokens, report layout, limits) lives in
#     the database settings center and is managed in the admin UI. Variables with
#     those names are NOT read by the API.
#   * The first API start runs the embedded migrations and seeds a fixed
#     administrator: username `admin`, password `admin123` (case-sensitive).
#     Change that password in the UI immediately after the first login.
#   * EZTEST_EXECUTOR_TOKEN / EZTEST_RENDER_TOKEN below are read by the executor
#     and renderer processes. They must equal the settings center values
#     `execution.executor_token` / `report.render_token`; the packaged defaults
#     match the API seed defaults. If you change one here, change the same value
#     in the settings center too, or executions/PDF reports fail with 401.
#   * EZTEST_ADMIN_USERNAME / EZTEST_ADMIN_PASSWORD are NOT read by the API (the
#     seed is fixed); they are only used by smoke-test.* to log in. Update
#     EZTEST_ADMIN_PASSWORD here after changing the admin password in the UI.
#   * Playwright browsers are used by both the executor and the PDF renderer;
#     PLAYWRIGHT_BROWSERS_PATH is rewritten to this package's absolute path.
#
# Only PostgreSQL 17 is an external prerequisite. See PACKAGE.md.
#
# Re-run init-config with -Force / --force to regenerate `.env` from this
# template (the old file is kept as `.env.bak`).

# ---- API process (the only variables the Go API reads) ----
# REQUIRED: PostgreSQL 17 connection string. Written by init-config from
# -DatabaseUrl/--database-url (or EZTEST_DATABASE_URL); replace the placeholder
# by hand otherwise. Migrations run automatically on the first start.
EZTEST_DATABASE_URL=postgres://eztest:<db-password>@localhost:5433/eztest?sslmode=disable
# API HTTP port (default 13333). The API derives its CORS origins from this port
# and EZTEST_WEB_PORT.
EZTEST_API_PORT=13333
# Web UI port (default 6868); the API allows this web origin for browser calls.
EZTEST_WEB_PORT=6868
# Executor port (default 13336). The API seeds its executor URL from this port on
# the first start; later changes are made in the settings center.
EZTEST_EXECUTOR_PORT=13336

# ---- Administrator seed used by smoke-test.* (the API ignores these keys) ----
EZTEST_ADMIN_USERNAME=admin
# Fixed first-start seed. Change the password in the UI after the first login and
# update this value here so smoke-test.* keeps working.
EZTEST_ADMIN_PASSWORD=admin123

# ---- Playwright executor process ----
# Shared Bearer token between API and executor (settings center:
# execution.executor_token). Packaged default matches the API seed default.
EZTEST_EXECUTOR_TOKEN=eztest-dev-executor-token
# Executor listen address (loopback by default; the API is its only client).
EZTEST_EXECUTOR_ADDR=127.0.0.1:13336
# Concurrent browser contexts (8 needs roughly 8 GB of free RAM when busy).
EZTEST_EXECUTOR_MAX_CONTEXTS=8
# Executor-wide WebSocket allow list (comma separated). Add remote test-target
# hosts explicitly when a case needs ws/wss to a non-loopback host.
EZTEST_EXEC_ALLOWED_HOSTS=localhost,127.0.0.1
# Request cap for approved visual baselines, used by the API and the executor.
EZTEST_VISUAL_BASELINE_MAX_BYTES=5242880

# ---- PDF renderer process ----
# Bearer token the API uses to call the renderer (settings center:
# report.render_token). Packaged default matches the API seed default.
EZTEST_RENDER_TOKEN=eztest-dev-render-token
# Renderer listen address (loopback by default; the API is its only client).
EZTEST_RENDERER_ADDR=127.0.0.1:13337

# ---- Web process (read by start-eztest.*; NODE_ENV is fixed for production) ----
NODE_ENV=production
PORT=6868
HOSTNAME=127.0.0.1

# ---- Bundled Playwright browser location (executor + renderer) ----
# Rewritten by init-config to this package's absolute path.
PLAYWRIGHT_BROWSERS_PATH=__PACKAGE_ROOT__/playwright-browsers
